<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Correo</title>
    <script>
        (function () {
            var tema = null;
            try { tema = localStorage.getItem('tema'); } catch (e) {}
            document.documentElement.setAttribute('data-bs-theme', tema || 'dark');
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/css/styles.css" rel="stylesheet">
</head>
<body>
<%
    String ruta = request.getRequestURI();
    boolean enEntrada = ruta.endsWith("/bandeja");
    boolean enDestacados = ruta.endsWith("/destacados");
    boolean enEnviados = ruta.endsWith("/enviados");
    boolean enBorradores = ruta.endsWith("/borradores");
    boolean enArchivo = ruta.endsWith("/archivo");
    boolean enSpam = ruta.endsWith("/spam");
    boolean enPapelera = ruta.endsWith("/papelera");
    boolean enAdmin = ruta.endsWith("/admin");
    jakarta.servlet.http.HttpSession sesionActual = request.getSession(false);
    boolean sesionIniciada = sesionActual != null && sesionActual.getAttribute("usuarioId") != null;
    boolean esAdministrador = sesionIniciada && Boolean.TRUE.equals(sesionActual.getAttribute("esAdministrador"));
    String correoSesion = sesionIniciada && sesionActual.getAttribute("correo") != null
            ? (String) sesionActual.getAttribute("correo") : "";
    String nombreSesion = sesionIniciada && sesionActual.getAttribute("nombre") != null
            ? (String) sesionActual.getAttribute("nombre") : "";
    String inicialSesion = nombreSesion.isEmpty() ? "?" : nombreSesion.substring(0, 1).toUpperCase();
%>
<header class="navbar cabecera px-3 sticky-top gap-2">
    <button class="btn btn-outline-secondary d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#menu">
        <i class="bi bi-list"></i>
    </button>
    <div class="d-flex flex-column lh-sm">
        <span class="navbar-brand fw-semibold text-purple p-0 m-0"><i class="bi bi-envelope-fill"></i> Correo</span>
        <% if (sesionIniciada) { %>
        <small class="text-muted text-truncate" style="max-width: 220px;"><%= correoSesion.replace("&", "&amp;").replace("<", "&lt;") %></small>
        <% } %>
    </div>
    <form method="get" action="buscar" class="ms-auto d-flex buscador">
        <input class="form-control form-control-sm" type="search" name="q" placeholder="Buscar correos" required>
    </form>
    <button type="button" id="btnTema" class="btn btn-outline-secondary" title="Cambiar tema">
        <i class="bi bi-sun"></i>
    </button>
    <% if (sesionIniciada) { %>
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar"><%= inicialSesion %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li><span class="dropdown-item-text small text-muted">Sesión iniciada como</span></li>
            <li><span class="dropdown-item-text fw-semibold text-truncate" style="max-width: 260px;"><%= correoSesion.replace("&", "&amp;").replace("<", "&lt;") %></span></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="login"><i class="bi bi-arrow-left-right"></i> Cambiar de cuenta</a></li>
            <li><a class="dropdown-item text-danger" href="logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a></li>
        </ul>
    </div>
    <% } %>
</header>
<div class="d-flex">
    <nav id="menu" class="offcanvas-lg offcanvas-start sidebar p-3">
        <div class="offcanvas-header d-lg-none">
            <h5 class="offcanvas-title">Menú</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-0">
            <a href="redactar" class="btn btn-purple w-100 mb-3"><i class="bi bi-pencil-square"></i> Redactar</a>
            <a href="bandeja" class="nav-link<%= enEntrada ? " active" : "" %>"><i class="bi bi-inbox"></i> Entrada</a>
            <a href="destacados" class="nav-link<%= enDestacados ? " active" : "" %>"><i class="bi bi-star"></i> Destacados</a>
            <a href="enviados" class="nav-link<%= enEnviados ? " active" : "" %>"><i class="bi bi-send"></i> Enviados</a>
            <a href="borradores" class="nav-link<%= enBorradores ? " active" : "" %>"><i class="bi bi-file-earmark"></i> Borradores</a>
            <a href="archivo" class="nav-link<%= enArchivo ? " active" : "" %>"><i class="bi bi-archive"></i> Archivo</a>
            <a href="spam" class="nav-link<%= enSpam ? " active" : "" %>"><i class="bi bi-exclamation-octagon"></i> Spam</a>
            <a href="papelera" class="nav-link<%= enPapelera ? " active" : "" %>"><i class="bi bi-trash"></i> Papelera</a>
            <% if (esAdministrador) { %>
            <a href="admin" class="nav-link<%= enAdmin ? " active" : "" %>"><i class="bi bi-gear"></i> Administración</a>
            <% } %>
        </div>
    </nav>
    <main class="flex-grow-1 p-3 p-lg-4">
<script>
    (function () {
        var boton = document.getElementById('btnTema');
        function esOscuro() {
            return document.documentElement.getAttribute('data-bs-theme') === 'dark';
        }
        function pintarIcono() {
            boton.querySelector('i').className = esOscuro() ? 'bi bi-sun' : 'bi bi-moon-stars';
        }
        boton.addEventListener('click', function () {
            var nuevo = esOscuro() ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', nuevo);
            try { localStorage.setItem('tema', nuevo); } catch (e) {}
            pintarIcono();
        });
        pintarIcono();
    })();
</script>